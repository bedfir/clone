# Personal data, the clone's own state and secrets must never enter an image (ADR-005, ADR-009).
data/
state/
.env
.env.*

# Version control and local environments
.git/
.venv/
venv/

# Caches and build output
**/__pycache__/
**/*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# The Dockerfile is not needed inside an image. compose.yaml, .dockerignore and .gitignore
# are copied into the dev image on purpose, so that their guard tests run there too.
Dockerfile
